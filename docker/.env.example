# Kasm Windows Studio — Tech Preview configuration
# Copy to .env in the same directory as docker-compose.yml.

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Encrypts every credential the appliance stores (Kasm API keys, hypervisor
# logins). The container refuses to start if this is unset.
#
#   Generate:  openssl rand -base64 32
#
# Back this value up somewhere safe. If you lose it, every stored credential
# becomes unrecoverable and must be re-entered. Never change it after first run.
APPLIANCE_MASTER_KEY=REPLACE_ME

# ─── NETWORK ─────────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser. Must include the URL you
# actually open the UI on, or the interface will load but every request fails.
ALLOWED_ORIGINS=https://localhost:8443

# Interface to publish the UI on. Default exposes it on all interfaces.
# Set to 127.0.0.1 to reach it only through an SSH tunnel or local proxy.
APPLIANCE_BIND=0.0.0.0

# Hostname or IP placed in the generated self-signed certificate's CN.
# Use the name administrators will type in the browser.
TLS_COMMON_NAME=localhost

# ─── FIXED FOR THE CONTAINER DEPLOYMENT ──────────────────────────────────────
# These match the paths and service names inside the compose file.
# Change them only if you also change docker-compose.yml.
DATABASE_URL=sqlite:////data/appliance.db
REDIS_URL=redis://redis:6379/0
APPLIANCE_PORT=8443
TLS_CERT_PATH=/etc/kasm-studio/ssl/cert.pem
TLS_KEY_PATH=/etc/kasm-studio/ssl/key.pem

# ─── OPTIONAL ────────────────────────────────────────────────────────────────
# Preview build to run. Pin to a specific tag for a repeatable evaluation.
IMAGE_TAG=latest

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Redis memory ceiling.
REDIS_MAXMEMORY=256mb
